{
    "name": "@meetio/meetio-icons",
    "version": "1.12.0",
    "description": "The most delicious and wonderful icons for Meetio Theme",
    "author": "Mauro Reis Vieira <mauroreisvieira@gmail.com>",
    "main": "dist/index.js",
    "typescript": {
        "definition": "dist/index.d.ts"
    },
    "files": [
        "icons/*.svg",
        "dist/*.js",
        "dist/*.d.ts"
    ],
    "types": "dist/index",
    "bugs": {
        "url": "https://github.com/meetio-theme/meetio-icons/issues"
    },
    "license": "MIT",
    "scripts": {
        "build": "tsc",
        "build:icons": "ts-node build/index.ts",
        "lint": "eslint \"scripts/*.ts\"",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "engines": {
        "node": "^10.0.0"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@babel/core": "7.29.6",
        "@babel/preset-env": "7.28.5",
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@resvg/resvg-js": "^2.6.2",
        "@typescript-eslint/eslint-plugin": "8.47.0",
        "@typescript-eslint/parser": "8.47.0",
        "babel-eslint": "^10.1.0",
        "eslint": "^9.39.1",
        "eslint-plugin-json": "^4.0.1",
        "glob": "^13.0.0",
        "husky": "^9.1.7",
        "prettier": "^3.6.2",
        "rimraf": "^6.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "picocolors": "^1.1.1"
    }
}
